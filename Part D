public class PartD {
    public static void main(String[] args){

        //Day of the Week
        int day=6;
        switch (day){
            case 1:
                System.out.println("Monday");
                break;
            case 2:
                System.out.println("Tuesday");
                break;
            case 3:
                System.out.println("Wednesday");
                break;
            case 4:
                System.out.println("Thrusday");
                break;
            case 5:
                System.out.println("Friday");
                break;
            case 6:
                System.out.println("Saturday");
                break;
            case 7:
                System.out.println("Sunday");
            default:
                System.out.println("Invalid day");
        }
//Food Menu
        int foodChoice=2;
        switch(foodChoice){
        case 1:
            System.out.println("Pizza for $6");
            break;
        case 2:
            System.out.println("Sandwich for $5");
            break;
        case 3:
            System.out.println("Pasta for $7");
        default:
            System.out.println("Invaid Food Option.");
}

//Simple Calculator

        int num1=8512345;
        int num2=12345678;
        String sign="+";

        switch (sign){
            case "+":
                System.out.println(num1+num2);
                break;
            case "-":
                System.out.println(num1-num2);
                break;
            case "*":
                System.out.println(num1*num2);
                break;
        }
//Traffic Light

        String lightColor="red";
switch (lightColor){
