public class PartB {
    public static void main (String[] args){
        //Pass or Try again
        int mark=95;
        if(mark>50) {
            System.out.println("Pass");
        }else{
            System.out.println("Try Again");
        }

        //Compare Two Numbers
        int num=51, num2=54;
        if (num>num2){
            System.out.println(num +" is larger than "+num2);
        }else {
            System.out.println(num2 + " is larger than " + num);
